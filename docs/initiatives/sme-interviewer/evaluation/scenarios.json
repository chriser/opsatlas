{
  "schema": 1,
  "what": "Scripted conversations for measuring the Tibi engine (OBS S10). Each turn names the routes it may take and the checks its reply must pass. services/sme_interviewer/evaluate_engine.py runs them through Tibi's own turn code against the approved records. Rehearsal scenarios (mode \"rehearsal\") play meeting lines (\"hear\") as context and score only the requests to Tibi (\"ask\").",
  "checks": {
    "one_question": "At most one question in the reply.",
    "no_question": "No question at all (closing).",
    "capital": "The reply starts with a capital letter.",
    "short": "At most 400 characters, as the prompt asks.",
    "about_itself": "Tibi answers about itself in the first person (I, I'm, my).",
    "no_product": "No claim about OpsAtlas in a social reply.",
    "supported": "A product answer cites approved records, and every figure in it appears in them.",
    "declines": "Declines an off-limits topic.",
    "no_copy": "No run of 8 or more words copied from the approved conversation guidance.",
    "no_repeat": "Does not repeat a question it already asked in this conversation.",
    "mentions": "Mentions at least one of the listed words.",
    "avoids": "Mentions none of the listed phrases.",
    "brief": "A rehearsal reply is at most 300 characters, so the floor returns to the salesperson quickly.",
    "new_point": "“What have I missed?” adds at least three words of substance the meeting has not said."
  },
  "scenarios": [
    {
