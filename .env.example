# OpsAtlas settings (generated: python -m assistant.settings > .env.example). Uncomment to change one.
# The Sales workspace overrides some of them for its cores: services/opsatlas_sales/profile.json.

# --- core ---
# A lone core's data folder; the Sales workspace sets one per space
# KP_DATA_DIR=data
# The Ollama server
# KP_OLLAMA_URL=http://127.0.0.1:11434
# The answer model
# KP_LLM_MODEL=qwen2.5:7b-instruct
# The embedding model
# KP_EMBED_MODEL=nomic-embed-text
# The answer model's context, in tokens
# KP_LLM_NUM_CTX=8192
# Seconds a generation may take
# KP_LLM_TIMEOUT=120
# Whether the answer model may reason first: 0, 1 or auto (ARCH H3a)
# KP_LLM_THINK=0
# The longest answer, in tokens; 0 for no bound (ARCH H3a)
# KP_LLM_NUM_PREDICT=1536
# Rewrite questions before retrieval: 1 or 0
# KP_QUERY_REWRITE=1
# Rerank retrieved passages with the model: 1 or 0
# KP_RERANK=1
# The retrieval relevance threshold
# KP_MIN_SIMILARITY=0.55
# Check answers against their cited evidence: 1 or 0
# KP_VALIDATE_GROUNDING=1
# Another Enterprise Activity Model taxonomy file
# KP_EAM_TAXONOMY=
# Who edits when no one is signed in (start-up, tests)
# KP_OPERATOR_NAME=Operator
# That operator's role
# KP_OPERATOR_ROLE=Platform operator
# The single shared password of the test setup; personal accounts replace it
# KP_OPERATOR_PASSWORD=
# The browser's origin for cookies and links; a lone core uses http://127.0.0.1:8010
# OPSATLAS_ORIGIN=http://127.0.0.1:8780
# The workspace the IAM host commands act on
# OPSATLAS_WORKSPACE=.runtime/opsatlas-sales

# --- governance ---
# Model-assisted governance in a lone core: 1 or 0
# KP_GOVERNANCE_LLM_ENABLED=0
# That governance model; empty means the answer model
# KP_GOVERNANCE_LLM_MODEL=
# Its context, in tokens; unset means KP_LLM_NUM_CTX
# KP_GOVERNANCE_LLM_NUM_CTX=
# Seconds a governance generation may take
# KP_GOVERNANCE_LLM_TIMEOUT=120
# Review new Sales records automatically: 1 or 0
# SALES_GOVERNANCE_AUTO_REVIEW=1
# The statement judge: local, or anthropic:<model>
# SALES_GOVERNANCE_JUDGE=local
# yes: the data owner approved sending records to a hosted judge
# SALES_GOVERNANCE_FRONTIER_APPROVED=

# --- services ---
# Tibi's voice service
# SME_TIBI_VOICE_URL=http://127.0.0.1:8773
# Tibi's Higgs voice quantisation, passed to its service on a restart
# SME_HIGGS_BITS=
# The process-diagram service
# PROCESS_DIAGRAM_SERVICE_URL=http://127.0.0.1:5300
# Seconds a diagram request may take
# PROCESS_DIAGRAM_TIMEOUT_SECONDS=4
# launchd: the diagram service is launchd's, never started loose
# PROCESS_DIAGRAM_MANAGED=
# The Python that starts a loose diagram service
# PROCESS_DIAGRAM_PYTHON=
# Start a loose diagram service with --reload: 1 or 0
# PROCESS_DIAGRAM_RELOAD=0
# The diagram service's log file
# PROCESS_DIAGRAM_LOG_PATH=

# --- avatar ---
# The Anam account key for the Digital SME
# ANAM_API_KEY=
# The Anam persona
# ANAM_PERSONA_ID=
